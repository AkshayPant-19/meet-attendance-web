# ---- Supabase (create a project at https://supabase.com) ----
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key (server only — NEVER expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL (used for auth email redirects). On Vercel set this to your
# production URL, e.g. https://meet-attendance-web.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
